# -----------------------------------------------------------------------------
# Questify · environment configuration
# Copy to .env.local and fill in. All values are optional: with none set the app
# runs in a fully interactive offline "demo mode" backed by localStorage.
# -----------------------------------------------------------------------------

# Supabase (public — safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role (SERVER ONLY — never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# Telegram bot token used to verify WebApp initData signatures
TELEGRAM_BOT_TOKEN=

# Secret used to sign session tokens returned by /api/telegram-auth
# Required: at least 32 random bytes (e.g. `openssl rand -hex 32`). No fallback.
QUESTIFY_JWT_SECRET=

# Public app + bot configuration (safe for the browser)
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_BOT_USERNAME=
# Optional direct-link short name: https://t.me/<bot>/<shortname>?startapp=<code>
NEXT_PUBLIC_MINIAPP_SHORTNAME=

# Secret token registered with Telegram setWebhook; validated on every update
TELEGRAM_WEBHOOK_SECRET=

# Shared secret for the server-to-server notify endpoint
NOTIFY_SECRET=

# Local dev only: allow sandbox/demo sessions (ignored when NODE_ENV=production)
DEMO_MODE=

# -----------------------------------------------------------------------------
# OAuth account linking (phase 4A) — Google / GitHub / Discord.
# Create an app with each provider, set the redirect URI to
#   ${NEXT_PUBLIC_APP_URL}/api/oauth/<provider>/callback
# (e.g. https://your-app.vercel.app/api/oauth/google/callback).
# Providers with empty credentials are disabled server-side (503).
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional but strongly recommended: GitHub personal access token (no scopes
# needed) used for star/fork verification. Unauthenticated GitHub API calls are
# limited to 60 requests/hour per IP; authenticated: 5,000/hour.
GITHUB_TOKEN=
